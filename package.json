    "dev": "node esbuild.config.mjs"
  },
  "keywords": [],
  "license": "MIT",
  "dependencies": {
    "yaml": "2.8.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "obsidian": "1.14.4",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
